# --- Google OAuth (Google Cloud Console → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Supabase (Project Settings → API). Use the service_role key; never ship it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Secrets you generate yourself
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- App
FRONTEND_URL=http://localhost:5173
MAX_SCAN_MESSAGES=5000
